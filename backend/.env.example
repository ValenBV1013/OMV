# Copiá este archivo como .env y completá las claves.
# NUNCA subas .env al repositorio.

# TomTom API Key (free tier)
# Obtener en: https://developer.tomtom.com → My Apps
TOMTOM_API_KEY=tu_api_key_acá

# HERE Maps API Key (fallback opcional)
# Obtener en: https://platform.here.com/sign-up
HERE_API_KEY=

# Django secret key (cambiar en producción)
DJANGO_SECRET_KEY=django-insecure-aib#hee%%rwoznyb9!*8ge#-vn0%=p!8!@b8j^4om(f9d(ga5j

# Debug mode
DJANGO_DEBUG=True
